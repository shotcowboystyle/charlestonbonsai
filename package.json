{
  "name": "charleston-bonsai",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "description": "Charleston Bonsai Gallery - Premium bonsai tree showcase",
  "scripts": {
    "pl": "PORTLESS_PORT=1355 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless",
    "dev": "pnpm pl run nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "lighthouse:ci": "pnpm build && pnpm lighthouse:desktop && pnpm lighthouse:mobile",
    "lighthouse:desktop": "pnpm pl lhci lhci autorun --config=lighthouserc.cjs",
    "lighthouse:mobile": "pnpm pl lhci lhci autorun --config=lighthouserc.mobile.cjs",
    "serve:lhci": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project server",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm pl e2e playwright test",
    "test:e2e:ui": "pnpm pl e2e playwright test --ui",
    "verify": "pnpm run lint:ci && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.2",
    "@supabase/supabase-js": "^2.115.0",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@types/qrcode": "^1.5.6",
    "@vercel/blob": "^2.8.0",
    "@vueuse/nuxt": "^15.0.0",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.26",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "three": "^0.185.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@lhci/cli": "^0.15.1",
    "@nuxt/devtools": "^4.0.0-alpha.17",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@nuxtjs/partytown": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "h3": "^2.0.2",
    "happy-dom": "^20.14.0",
    "lighthouse": "^13.5.0",
    "nuxt": "^4.5.2",
    "playwright-core": "^1.63.0",
    "portless": "^0.15.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
