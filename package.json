    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/vue-3": "^3.30.5",
    "@types/qrcode": "^1.5.6",
    "@vercel/blob": "^2.8.0",
    "@vueuse/nuxt": "^14.4.0",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.0",
